# ========================================
# Resend (メール通知) — 必須
# ========================================
# 発行: https://resend.com/api-keys
RESEND_API_KEY=

# 送信元アドレス。
#   - 独自ドメイン未検証時はこの値を推奨: "Simple Records <onboarding@resend.dev>"
#     ※ただしドメイン検証前はResendアカウント所有者のメールアドレス宛にしか送れない
#   - 独自ドメイン検証後は "Simple Records <noreply@yourdomain.com>" 等に差し替え
MAIL_FROM="Simple Records <onboarding@resend.dev>"

# 通知先（応募を受け取るアドレス）
MAIL_TO=simple.records.2022@gmail.com

# ========================================
# Supabase (応募の保存先) — 必須
# ========================================
# 値は 1Password「Simple Records」保管庫にある。手元では .env.op（op:// 参照のみ）を
#   op run --env-file=.env.op -- npm run dev
# で展開して使う。Vercel には同じ名前で登録する。
# どれもサーバー側だけで使う。NEXT_PUBLIC_ を付けないこと（ブラウザに渡る）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 管理ページ（/admin）のログイン用。サーバー側だけで使う
SUPABASE_ANON_KEY=

# ========================================
# Sentry (エラーモニタリング) — 任意
# ========================================
# 未設定の場合、Sentry初期化はスキップされる。
# サーバ側DSN（Node/Edgeランタイム用）。
SENTRY_DSN=
# クライアント側DSN（ブラウザ用）。通常は SENTRY_DSN と同じ値でOK。
NEXT_PUBLIC_SENTRY_DSN=
